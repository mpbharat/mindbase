name = "brain-worker"
main = "src/index.ts"
compatibility_date = "2024-11-01"
compatibility_flags = ["nodejs_compat"]

# Your Cloudflare account ID — find it at dash.cloudflare.com (top-right)
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

[vars]
ENVIRONMENT = "production"
# Set BRAIN_WORKER_URL after deploying: https://brain-worker.<subdomain>.workers.dev
BRAIN_WORKER_URL = "https://brain-worker.YOUR_SUBDOMAIN.workers.dev"

[ai]
binding = "BRAIN_AI"

[[r2_buckets]]
binding = "BRAIN_DRIVE"
bucket_name = "brain-drive"

# Secrets — set these with: npx wrangler secret put SECRET_NAME
# DATABASE_URL       — Neon PostgreSQL connection string
# BRAIN_API_KEY      — generate any strong random string
# ANTHROPIC_API_KEY  — from console.anthropic.com
